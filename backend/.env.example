APP_NAME=Sistema de Administración de Préstamos
APP_VERSION=1.0.0
DATABASE_URL=sqlite:///./database/prestamos.db

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIAR
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

BACKUP_DIR=./backups
DATA_DIR=./data
RECIBOS_DIR=./recibos
LOGS_DIR=./logs

# Producción: https://su-dominio.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8765
MAX_UPLOAD_MB=10

# Solo se usa al crear el admin la primera vez
DEFAULT_ADMIN_PASSWORD=CAMBIAR

# Producción: ENABLE_DOCS=false
ENABLE_DOCS=true
